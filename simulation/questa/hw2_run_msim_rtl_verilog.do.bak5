transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}

if {![file exists controller.tv] && [file exists ../../controller.tv]} {
	file copy -force ../../controller.tv controller.tv
}

vlib rtl_work
vmap work rtl_work

vlog -sv -work work +incdir+C:/Users/furka/Projects/ELE432_MulticycleRiscv {C:/Users/furka/Projects/ELE432_MulticycleRiscv/controller.sv}
vlog -sv -work work +incdir+C:/Users/furka/Projects/ELE432_MulticycleRiscv {C:/Users/furka/Projects/ELE432_MulticycleRiscv/maindec.sv}
vlog -sv -work work +incdir+C:/Users/furka/Projects/ELE432_MulticycleRiscv {C:/Users/furka/Projects/ELE432_MulticycleRiscv/aludec.sv}
vlog -sv -work work +incdir+C:/Users/furka/Projects/ELE432_MulticycleRiscv {C:/Users/furka/Projects/ELE432_MulticycleRiscv/instrdec.sv}

vlog -sv -work work +incdir+C:/Users/furka/Projects/ELE432_MulticycleRiscv {C:/Users/furka/Projects/ELE432_MulticycleRiscv/ELE432_controller_testbenchsv_14-04-2026.sv}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L cyclonev_ver -L cyclonev_hssi_ver -L cyclonev_pcie_hip_ver -L rtl_work -L work -voptargs="+acc"  testbench

add wave -r sim:/*
view structure
view signals
run 10000
